# Maintainer template. Obtain authorized values before building for distribution.
# Client configuration is public, but no service secrets belong here.
POD_API_ORIGIN=https://pixondeck.com
POD_SITE_ORIGIN=https://pixondeck.com
POD_CLERK_PUBLISHABLE_KEY=
POD_CLERK_FRONTEND_API=https://clerk.pixondeck.com
POD_CLERK_SYNC_HOST=https://clerk.pixondeck.com
# PUBLIC key assigned by Chrome Web Store, never a private signing key.
POD_EXTENSION_PUBLIC_KEY=
# Leave unset to use package.json.
# POD_EXTENSION_VERSION=
